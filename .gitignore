# Training outputs
#checkpoints/
training_data/
*.pt
*.pth

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
env/
venv/
*.egg-info/

# IDEs
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Outputs
*.csv
# ...but the benchmark scores ARE the paper's evidence and must be versioned.
# Every number in Tables 2 and 3 is read from these files; leaving them
# untracked is how the SAM 3 text row came to disagree with its own predictions.
!benchmark/results/**/*.csv
*.bak
outputs/
checkpoints/
checkpoints-new/
gpu-checkpoints/
# every training run writes ~250-700 MB of weights; never commit these
checkpoints-*/
# stray zero-byte files from interrupted shells
.Rhistory
# Jupyter
.ipynb_checkpoints/

# Logs
*.log

# Symlinks to neurons-labeling repo
labeled_masks
labeled_coordinates

# Benchmark: scripts ARE tracked; heavy artefacts are not.
# benchmark/ totals ~7.6 GB — 5.9 GB of competitor virtualenvs and 1.7 GB of
# prediction TIFFs. `git add benchmark/` would try to commit all of it.
benchmark/competitors/
benchmark/predictions/
benchmark/__pycache__/

# SAM 3 is cloned into the repo root on the cluster for `pip install -e .`.
# It is a separate upstream git repo (~60 MB) — never ours to track.
sam3/

# figure-tracing scratch
paper_assets/paper/*.aux
paper_assets/paper/*.log
