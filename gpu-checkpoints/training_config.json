{
  "sam2_model_id": "facebook/sam2.1-hiera-tiny",
  "freeze_image_encoder": true,
  "lora": {
    "rank": 16,
    "alpha": 32.0,
    "dropout": 0.1,
    "hiera_last_stage": true,
    "hiera_rank": 8,
    "hiera_alpha": 16.0
  },
  "data": {
    "training_data_dir": "training_data",
    "num_frames": 8,
    "image_size": 1024,
    "max_objects": 3,
    "val_fraction": 0.25,
    "val_videos": null,
    "clip_stride": 4,
    "cache_in_memory": true,
    "precompute_features": false
  },
  "augmentation": {
    "horizontal_flip_p": 0.5,
    "vertical_flip_p": 0.5,
    "rotation_degrees": 25.0,
    "shear": 20.0,
    "brightness": 0.15,
    "contrast": 0.15,
    "normalize_mean": null,
    "normalize_std": null
  },
  "optimizer": {
    "base_lr": 1e-05,
    "lora_lr": 0.0001,
    "lora_b_lr_ratio": 16.0,
    "weight_decay": 0.05,
    "max_grad_norm": 1.0,
    "warmup_epochs": 2,
    "use_cosine_schedule": true,
    "min_lr_ratio": 0.05
  },
  "loss": {
    "loss_mask_weight": 5.0,
    "loss_dice_weight": 2.0,
    "loss_cbdice_weight": 5.0,
    "loss_supervoxel_weight": 0.3,
    "loss_iou_weight": 1.0,
    "loss_class_weight": 1.0,
    "focal_alpha": 0.25,
    "focal_gamma": 2.0,
    "use_cbdice": true,
    "cbdice_num_iter": 5,
    "use_supervoxel": true,
    "topology_resolution": 256
  },
  "batch_size": 2,
  "num_epochs": 90,
  "num_workers": 2,
  "seed": 42,
  "use_amp": true,
  "compile_encoder": false,
  "compile_decoder": false,
  "val_every_n_epochs": 2,
  "val_max_batches": 0,
  "early_stopping_patience": 15,
  "checkpoint_dir": "checkpoints",
  "save_best_only": true,
  "prob_to_use_pt_input": 0.0,
  "num_init_cond_frames": 1,
  "use_memory_attention_path": true,
  "resume_from": "checkpoints/train_state.pt",
  "log_every_n_steps": 10
}